{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "backend/api/portal.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/portal-auth(?:/.*)?",
      "dest": "/backend/api/portal.ts"
    },
    {
      "src": "/api/club-portal(?:/.*)?",
      "dest": "/backend/api/portal.ts"
    },
    {
      "src": "/api/league-portal(?:/.*)?",
      "dest": "/backend/api/portal.ts"
    },
    {
      "src": "/admin/portal-rollout(?:/.*)?",
      "dest": "/backend/api/portal.ts"
    },
    {
      "src": "/portal-health",
      "dest": "/backend/api/portal.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.ts"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/backend/api/index.ts"
    },
    {
      "src": "/health",
      "dest": "/backend/api/index.ts"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/backend/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "installCommand": "npm ci && npm --prefix backend ci && PLAYWRIGHT_BROWSERS_PATH=0 npm --prefix backend run playhq:install-browser",
  "env": {
    "PLAYWRIGHT_BROWSERS_PATH": "0"
  }
}
